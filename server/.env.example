# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI (Database name: studentDB)
# Format: mongodb+srv://<username>:<password>@<cluster-address>/studentDB?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/studentDB?retryWrites=true&w=majority

# Frontend Application URL (for CORS allowlist, comma-separated)
FRONTEND_URL=http://localhost:5173

# Optional: Switchable Authentication (Default is false)
AUTH_ENABLED=false
# MCP_API_TOKEN=your-mcp-shared-token-secret
# ADMIN_API_TOKEN=your-admin-token-secret
